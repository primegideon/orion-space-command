{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "functions": {
    "frontend/src/app/api/agent/route.ts":            { "maxDuration": 60 },
    "frontend/src/app/api/agent/sentinel/route.ts":   { "maxDuration": 60 },
    "frontend/src/app/api/agent/forecaster/route.ts": { "maxDuration": 60 },
    "frontend/src/app/api/agent/archivist/route.ts":  { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    }
  ]
}
