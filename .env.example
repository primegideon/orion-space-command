# ─── Next.js (frontend tier) ──────────────────────────────────────────────────
# Base URL of the running Langflow instance.
# For local development: http://localhost:7860
# For Vercel deployment: set to your ngrok public URL, e.g. https://abc123.ngrok.io
LANGFLOW_URL=http://localhost:7860

# The Langflow flow ID of the master router flow.
# Find it in the Langflow UI URL: /flow/<FLOW_ID>
LANGFLOW_FLOW_ID=

# NASA Open APIs key (https://api.nasa.gov — free registration)
NASA_API_KEY=

# ─── Python / Langflow tier ───────────────────────────────────────────────────
# IBM watsonx credentials (https://dataplatform.cloud.ibm.com)
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
# watsonx regional URL, e.g. https://us-south.ml.cloud.ibm.com
WATSONX_URL=https://us-south.ml.cloud.ibm.com
