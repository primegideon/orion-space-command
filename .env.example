# ─── IBM watsonx.ai ───────────────────────────────────────────────────────────
# https://dataplatform.cloud.ibm.com
WATSONX_API_KEY=your_ibm_cloud_api_key
WATSONX_PROJECT_ID=your_watsonx_project_id
WATSONX_URL=https://us-south.ml.cloud.ibm.com
# Optional: override the Archivist RAG synthesis model (default: ibm/granite-3-8b-instruct)
# WATSONX_ARCHIVIST_MODEL=ibm/granite-3-8b-instruct

# ─── NASA Open APIs ───────────────────────────────────────────────────────────
# Free registration at https://api.nasa.gov
NASA_API_KEY=your_nasa_api_key

# ─── Supabase pgvector ────────────────────────────────────────────────────────
# https://supabase.com — used for RAG document store and system_logs table
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ─── Google AI Studio (Gemini) ────────────────────────────────────────────────
# https://aistudio.google.com/app/apikey — used by Sentinel for NL summaries
# Falls back to watsonx if absent
GEMINI_API_KEY=your_google_ai_studio_api_key

# ─── GitHub Models (GPT-4o via Azure inference) ───────────────────────────────
# GitHub PAT with models:read scope — used by Forecaster for NL summaries
# https://github.com/settings/tokens — Falls back to watsonx if absent
GITHUB_TOKEN=your_github_personal_access_token
